/* WebAudio 재생기: <audio>와 같은 모양으로 만들어서 기존 코드를 그대로 쓸 수 있어요 */
class WAPlayer{
  constructor(url){this.url=url;this.ev={};this.ctx=null;this.buf=null;this.src=null;this.gain=null;this._vol=.7;this._off=0;this._start=0;this._playing=false;this.ended=false;this.duration=NaN}
  addEventListener(n,f){(this.ev[n]=this.ev[n]||[]).push(f)}
  _emit(n){(this.ev[n]||[]).slice().forEach(f=>f())}
  set volume(v){this._vol=v; if(this.gain) this.gain.gain.value=v}
  get volume(){return this._vol}
  get currentTime(){return this._playing?Math.min(this.duration,this._off+(this.ctx.currentTime-this._start)):this._off}
  set currentTime(t){const was=this._playing; this._stop(); this._off=Math.max(0,t); if(was&&this.buf) this._go()}
  async _ensure(){
    if(!this.ctx){const AC=window.AudioContext||window.webkitAudioContext; this.ctx=new AC(); this.gain=this.ctx.createGain(); this.gain.gain.value=this._vol; this.gain.connect(this.ctx.destination)}
    if(this.ctx.state==='suspended') await this.ctx.resume();
    if(!this.buf){
      const bin=atob(this.url.split(',')[1]); const u=new Uint8Array(bin.length); for(let k=0;k<bin.length;k++) u[k]=bin.charCodeAt(k);
      this.buf=await new Promise((res,rej)=>{const p=this.ctx.decodeAudioData(u.buffer,res,rej); if(p&&p.catch) p.catch(rej)});
      this.duration=this.buf.duration; this._emit('loadedmetadata');
    }
  }
  _go(){
    const s=this.ctx.createBufferSource(); s.buffer=this.buf; s.connect(this.gain);
    s.onended=()=>{ if(this.src===s){this.src=null; this._playing=false; this._off=0; this.ended=true; this._emit('ended')} };
    this._start=this.ctx.currentTime; s.start(0,this._off); this.src=s; this._playing=true;
  }
  _stop(){ if(this._playing) this._off=this.currentTime; if(this.src){const s=this.src; this.src=null; s.onended=null; try{s.stop()}catch(e){}} this._playing=false }
  play(){
    return this._ensure().then(()=>{ if(this._off>=this.duration-0.05) this._off=0; this.ended=false; if(!this._playing) this._go(); this._emit('play') })
      .catch(e=>{this._emit('error'); throw e});
  }
  pause(){this._stop(); this._emit('pause')}
}
function muInit(){
  $('#mu-art').src=MUSIC.art; $('#mu-title').textContent=MUSIC.title; $('#mu-artist').textContent=MUSIC.artist;
  [['rw','rw'],['ff','ff'],['more','more'],['vlo','vlo'],['vhi','vhi'],['lyr','lyr'],['air','air'],['list','list']].forEach(([id,k])=>{$('#mu-'+id).innerHTML=MU_SVG[k]});
  if(MUSIC.audioUrl){
    /* 소리 파일이 HTML 안에 들어 있어요. 뷰어가 data: 주소 재생을 막아도 되도록 3단계로 시도해요:
       1) blob 주소로 일반 재생  2) 안 되면 WebAudio로 직접 디코딩해서 재생 */
    const wire=(a,onErr)=>{
      a.addEventListener('loadedmetadata',()=>{if(isFinite(a.duration)){MU.dur=a.duration;muUI()}});
      a.addEventListener('play',()=>muState(true));
      a.addEventListener('pause',()=>{if(!a.ended) muState(false)});
      a.addEventListener('ended',()=>{MU.want=false;a.currentTime=0;MU.t=0;muState(false)});
      a.addEventListener('error',onErr);
    };
    const fail=()=>{MU.want=false;muState(false);toast('음악 파일을 불러오지 못했어요')};
    const useWA=()=>{ const w=MU.au=new WAPlayer(MUSIC.audioUrl); w.volume=MU.vol; wire(w,fail); };
    let blobUrl=null;
    try{
      const bin=atob(MUSIC.audioUrl.split(',')[1]); const u=new Uint8Array(bin.length);
      for(let k=0;k<bin.length;k++) u[k]=bin.charCodeAt(k);
      blobUrl=URL.createObjectURL(new Blob([u],{type:'audio/mpeg'}));
    }catch(e){}
    if(blobUrl){
      const a=MU.au=new Audio(blobUrl); a.preload='auto'; a.volume=MU.vol;
      let swapped=false;
      wire(a,()=>{ if(swapped) return; swapped=true; if(MU.playing) return; useWA(); if(MU.want) muPlay(); });
    } else useWA();
  } else {
    /* 유튜브: 화면 밖에 숨겨 둔 재생기를 body에 붙여 두기 때문에, 앱을 닫아도 소리는 계속 나요 */
    const box=document.createElement('div'); box.setAttribute('aria-hidden','true');
    box.style.cssText='position:fixed;left:-400px;top:0;width:200px;height:200px;opacity:0;pointer-events:none';
    box.innerHTML='<div id="mu-yt"></div>'; document.body.appendChild(box);
    window.onYouTubeIframeAPIReady=()=>{
      const pv={playsinline:1,controls:0,disablekb:1,fs:0,rel:0,iv_load_policy:3};
      if(/^https?:/.test(location.protocol)&&location.origin!=='null') pv.origin=location.origin;
      MU.yt=new YT.Player('mu-yt',{width:200,height:200,videoId:MUSIC.videoId,playerVars:pv,events:{
        onReady:()=>{MU.ytReady=true; MU.yt.setVolume(Math.round(MU.vol*100)); const d=MU.yt.getDuration(); if(d>0){MU.dur=d;muUI()} if(MU.want) MU.yt.playVideo()},
        onStateChange:e=>{const s=e.data;
          if(s===1){const d=MU.yt.getDuration(); if(d>0) MU.dur=d; muState(true)}
          else if(s===2) muState(false);
          else if(s===0){MU.want=false; MU.t=0; MU.yt.stopVideo(); muState(false)}},
        onError:()=>{MU.want=false; muState(false); toast('이 영상은 재생할 수 없어요 (퍼가기 차단)')}
      }});
    };
    const sc=document.createElement('script'); sc.src='https://www.youtube.com/iframe_api'; sc.onerror=()=>{MU.ytFail=true}; document.head.appendChild(sc);
    setTimeout(()=>{if(!MU.ytReady) MU.ytFail=true},4000);
  }
  $('#mu-file').addEventListener('change',e=>{
    const f=e.target.files&&e.target.files[0]; if(!f) return;
    if(MU.yt&&MU.ytReady) MU.yt.pauseVideo();
    const a=MU.au=new Audio(URL.createObjectURL(f)); a.volume=MU.vol;
    a.addEventListener('loadedmetadata',()=>{if(isFinite(a.duration)){MU.dur=a.duration;muUI()}});
    a.addEventListener('play',()=>muState(true)); a.addEventListener('pause',()=>{if(!a.ended) muState(false)});
    a.addEventListener('ended',()=>{MU.want=false;a.currentTime=0;MU.t=0;muState(false)});
    muPlay();
  });
  $('#app-music').addEventListener('click',e=>{
    const b=e.target.closest('[data-mu]'); if(!b) return; const t=b.dataset.mu;
    if(t==='pp') MU.playing?muPause():muPlay();
    else if(t==='rw') muSeek(0);
    else if(t==='ff'){muPause(); muSeek(0)}
    else if(t==='fav'){MU.fav=!MU.fav; muUI()}
  });
