  const sig=lkSigOf(); if(sig===lkSig) return; lkSig=sig;
  $('#lk-n').innerHTML=top.map((n,i)=>`<div class="lkc${LKSEEN.has(lkKeys[i])?'':' pend'}" data-k="${lkKeys[i]}"><span class="ai">${uq(APPICON[n.app])}</span><span class="tx"><b>${esc(dname(n.app,ent(n.app,n.id)))}</b><span>${esc(n.text)}</span></span></div>`).join('');
