.kk-rh>b{position:absolute;top:50px;left:110px;right:140px;text-align:center;line-height:44px;font:700 17px/44px var(--ph);color:#1a2733;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.kk-tools{position:absolute;right:16px;top:50px;height:44px;border-radius:22px;padding:0 17px;display:flex;align-items:center;gap:19px;pointer-events:auto}
.kk-tools svg{width:23px;height:23px;fill:none;stroke:#1d2a36;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
#kk-room .km{display:flex;gap:7px;margin:3px 0 0;align-items:flex-start}
#kk-room .km.first{margin-top:14px}
#kk-room .km.me{justify-content:flex-end;align-items:flex-end}
#kk-room .kav.s{width:33px;height:33px;border-radius:12px;overflow:hidden;box-shadow:none;display:flex;align-items:center;justify-content:center}
#kk-room .kav.s img{width:100%;height:100%;object-fit:cover;display:block}
#kk-room .kspace{width:33px}
#kk-room .kn{font-size:13.5px;color:#3b4a58;margin:0 0 3px 1px}
#kk-room .kbub{background:#fff;color:#000;font-size:16.5px;line-height:1.3;padding:6px 14px 7px;border-radius:20px;max-width:245px;position:relative}
#kk-room .km.me .kbub{background:#f9e54a;color:#111}
#kk-room .kbub.beak{border-top-left-radius:6px}
#kk-room .km.me .kbub.beak{border-top-left-radius:20px;border-top-right-radius:6px}
#kk-room .kbub.beak::before{content:"";position:absolute;top:0;left:-6px;width:9px;height:11px;background:#fff;clip-path:polygon(0 0,100% 0,100% 100%)}
#kk-room .km.me .kbub.beak::before{left:auto;right:-6px;background:#f9e54a;clip-path:polygon(0 0,100% 0,0 100%)}
#kk-room .kt{font-size:13px;color:#566878;padding-bottom:1px}
#kk-room .kdv{margin:16px 0 8px}
#kk-room .kdv span{background:rgba(55,80,105,.17);color:#1e2e3c;font:500 15px/1.2 var(--ph);border-radius:14px;padding:5px 14px;display:inline-flex;align-items:center;gap:5px}
#kk-room .kdv span svg{width:8px;height:13px}
.kk-down{position:absolute;right:16px;bottom:92px;z-index:6;width:38px;height:38px;border-radius:50%;border:0;background:#fff;box-shadow:0 2px 12px rgba(40,70,100,.22);display:flex;align-items:center;justify-content:center;padding:0;cursor:pointer}
.kk-down svg{width:18px;height:18px}
.kk-down[hidden]{display:none}
#kk-room .kcmp{position:absolute;left:20px;right:20px;bottom:24px;z-index:6;padding:0;background:none;display:block}
.kk-field{height:47px;border-radius:24px;display:flex;align-items:center;gap:6px;padding:0 7px 0 7px}
#kk-room .kcmp .plus{width:34px;height:34px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;flex:none;color:#1d2a36;font-size:0}
#kk-room .kcmp .plus svg{width:17px;height:17px}
#kk-room .kcmp input{flex:1;min-width:0;height:100%;border:0;background:transparent;padding:0 4px;font:17px var(--ph);color:#111;outline:none;border-radius:0}
#kk-room .kcmp input::placeholder{color:#8f9ba7}
.kk-field .emo{width:30px;height:30px;border-radius:50%;background:rgba(150,160,172,.42);display:flex;align-items:center;justify-content:center;flex:none}
.kk-field .emo svg{width:19px;height:19px;fill:#1d2a36}
.kk-field .hash{width:34px;height:34px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;flex:none;font:700 21px var(--ph);color:#1d2a36}
#kk-room .kcmp .go{width:34px;height:34px;border-radius:50%;border:0;background:#fff;display:flex;align-items:center;justify-content:center;flex:none;padding:0;cursor:pointer;color:inherit}
#kk-room .kcmp .go svg{width:20px;height:20px}
#kk-room .kcmp .go .up{display:none;fill:#111;width:17px;height:17px}
#kk-room .kcmp .go.on{background:#f9e54a}
#kk-room .kcmp .go.on .wv{display:none}
#kk-room .kcmp .go.on .up{display:block}
</style>
</head>
<body>
