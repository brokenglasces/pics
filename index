const POD={cur:null,pos:{},playing:false,started:false,tm:null,audio:null,subs:{}};
const podList=()=>CONFIG.podcast.results;
const podEp=id=>podList().find(r=>r.id===id);
function podFmt(sec,up){sec=Math.max(0,sec);let h=Math.floor(sec/3600),m=(up?Math.ceil:Math.round)((sec%3600)/60);if(m>=60){h++;m-=60}return h?`${h}시간${m?' '+m+'분':''}`:`${m}분`}
function podDate(r){const [d,m,y]=r.date.split('/');return `${y}년 ${+m}월 ${+d}일`}
function podMeta(r){const p=POD.pos[r.id]||0, cur=POD.cur===r.id; return `${r.date} · ${(cur||p>0)?podFmt(r.dur-p,true)+' 남음':podFmt(r.dur)}`}
function podUseAudio(){return !!(POD.audio && POD.cur===CONFIG.podcast.main)}
function podRender(){
  const L=$('#pdc-list'); if(!L) return; const keep=L.scrollTop;
  L.innerHTML=podList().map(r=>{
    if(r.kind==='show'){const on=POD.subs[r.id]; return `<div class="pdc-r"><img class="pdc-a" src="${PODART[r.art]}" alt=""><div class="pdc-t"><div class="pdc-n sh">${esc(r.title)}</div><div class="pdc-n sub">프로그램 · ${esc(r.sub)}</div></div><button class="pdc-b" data-pdc="sub" data-id="${r.id}" aria-label="구독">${on?PDC_SVG.check:PDC_SVG.plus}</button></div>`}
    const isP=POD.cur===r.id&&POD.playing;
    return `<div class="pdc-r"><img class="pdc-a" src="${PODART[r.art]}" alt=""><div class="pdc-t"><span class="pdc-m" data-meta="${r.id}">${esc(podMeta(r))}</span><div class="pdc-n">${esc(r.title)}</div></div><button class="pdc-b" data-pdc="play" data-id="${r.id}" aria-label="${isP?'일시정지':'재생'}">${isP?PDC_SVG.pause:PDC_SVG.play}</button></div>`}).join('');
  L.scrollTop=keep; podMini();
}
function podMini(){
  const r=podEp(POD.cur), m=$('#pdc-mini'); if(!m) return;
  if(!r){m.style.display='none';return} m.style.display='';
  m.innerHTML=`<img src="${PODART[r.art]}" alt=""><div class="pdc-mt"><b>${esc(r.title)}</b><span>${podDate(r)}</span></div><button class="pdc-mp" data-pdc="toggle" aria-label="${POD.playing?'일시정지':'재생'}">${POD.playing?PDC_SVG.mpause:PDC_SVG.mplay}</button><button class="pdc-ms" data-pdc="skip" aria-label="30초 앞으로">${PDC_SVG.skip}</button>`;
}
function podTickUI(){const r=podEp(POD.cur); if(!r) return; const el=document.querySelector(`[data-meta="${r.id}"]`); if(el) el.textContent=podMeta(r)}
function podTick(){const r=podEp(POD.cur); if(!r) return; POD.pos[r.id]=Math.min(r.dur,(POD.pos[r.id]||0)+1); if(POD.pos[r.id]>=r.dur) podSet(false); else podTickUI()}
function podSet(on){
  POD.playing=on; clearInterval(POD.tm);
  const r=podEp(POD.cur), a=POD.audio;
  if(podUseAudio()){ if(on){ const p=a.play(); if(p&&p.catch) p.catch(()=>{POD.playing=false;podRender()}) } else a.pause() }
  else { if(a) a.pause(); if(on&&r) POD.tm=setInterval(podTick,1000) }
  podRender();
}
function podLoad(id){
  if(POD.cur===id) return; if(POD.audio) POD.audio.pause(); clearInterval(POD.tm); POD.cur=id;
  if(podUseAudio()&&POD.audio){POD.audio.currentTime=POD.pos[id]||0}
}
function podInit(){
  const c=CONFIG.podcast; POD.cur=c.main;
  if(c.audioUrl){
    const a=POD.audio=new Audio(); a.preload='none'; a.src=c.audioUrl;
    a.addEventListener('timeupdate',()=>{const r=podEp(c.main); if(r&&POD.cur===c.main){POD.pos[r.id]=a.currentTime; podTickUI()}});
    a.addEventListener('loadedmetadata',()=>{const r=podEp(c.main); if(r&&isFinite(a.duration)){r.dur=Math.round(a.duration); podTickUI()}});
    a.addEventListener('ended',()=>podSet(false));
    a.addEventListener('error',()=>{POD.audio=null; if(POD.playing){podSet(true)}});
  }
  $('#app-pod').addEventListener('click',e=>{
    const b=e.target.closest('[data-pdc]'); if(!b) return; const t=b.dataset.pdc, id=b.dataset.id;
    if(t==='play'){ if(POD.cur===id) podSet(!POD.playing); else {podLoad(id); podSet(true)} }
    else if(t==='toggle') podSet(!POD.playing);
    else if(t==='skip'){const r=podEp(POD.cur); if(!r) return; const np=Math.min(r.dur,(POD.pos[r.id]||0)+30); POD.pos[r.id]=np; if(podUseAudio()) POD.audio.currentTime=np; podTickUI()}
    else if(t==='sub'){POD.subs[id]=!POD.subs[id]; podRender()}
  });
}
function renderPodcast(){ if(!POD.started){POD.started=true; podRender(); podSet(true)} else podRender() }
