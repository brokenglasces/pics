function showMatch(p){matchId=p.id;$('#mph').innerHTML=pfPhoto(p)+'<span class="mh"><svg viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg></span>';$('#matchm').classList.add('on');$('#screen').dataset.light=''}
function closeMatch(){$('#matchm').classList.remove('on');$('#screen').dataset.light=(locked||(U.app==null&&false))?'':'1'}
function matchNow(p){
  const st=S.sb[p.id]; if(st.state==='matched') return;
  st.state='matched'; st.msgs.push({from:'sys',text:'매칭되었어요 · 서로 모르는 사이',ts:Date.now()});
  refresh('sb'); queue('sb',p.id,p.opening);
  if(U.app==='sb'&&!locked&&!call) showMatch(p);
}
function openSb(id){
  const p=ent('sb',id), st=S.sb[id];
  if(st.state!=='matched'){
    st.state='matched'; st.msgs.push({from:'sys',text:'매칭되었어요 · 서로 모르는 사이',ts:Date.now()});
    if(p.matchBack===false) st.msgs.push({from:'sys',text:'상대가 아직 메시지를 읽지 않았어요',ts:Date.now()}); else queue('sb',id,p.opening);
  }
  U.sb.id=id; st.unread=0; $('#sb-main').hidden=true; $('#sb-room').hidden=false;
  $('#sb-av').innerHTML=avatar('sb',p,36); $('#sb-nm').textContent=`${p.name} · ${distOf(p)}`;
