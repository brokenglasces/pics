}
function renderContacts(){
  const list=CONFIG.contacts.filter(c=>c.saved!==false&&c.number).sort((a,b)=>a.name.localeCompare(b.name,'ko'));
  $('#ct-rows').innerHTML=list.map(c=>`<button class="rc" data-act="call-contact" data-id="${c.id}">${avatar('sms',c,40)}<span class="mid"><span><b>${esc(c.name)}</b><small>${esc(c.number)}</small></span></span></button>`).join('');
}

/* ---------- 통화 ---------- */
const alive=id=>call&&call.id===id;
function startCall(number,contact,incoming){
  if(call||ending) return; if(locked) unlock();
  const id=++callSeq;
  call={id,number,contact,incoming:!!incoming,state:incoming?'incoming':'dialing',lines:[],t0:0};
  $('#screen').classList.add('incall'); $('#call').classList.add('on'); $('#banner').classList.remove('on'); renderCall();
  if(incoming) return;
  const cfg=contact?contact.call:CONFIG.unknownCall;
  (async()=>{
    if(!cfg){ await sleep(5000); if(alive(id)) endCall(); return; }
    await sleep(cfg.ringMs||2200); if(alive(id)) connect(id);
  })();
}
function connect(id){
  if(!alive(id)) return;
  call.state='live'; call.t0=Date.now(); renderCall();
  timerId=setInterval(()=>{if(!call)return;const el=$('#cl-st');if(el)el.textContent=mmss(Math.floor((Date.now()-call.t0)/1000))},400);
  const cfg=call.contact?call.contact.call:CONFIG.unknownCall; if(!cfg) return;
  play(id,(call.incoming&&cfg.incomingLines)||cfg.lines||[],cfg.hangupAfter);
}
async function play(id,lines,hang){
  for(const ln of lines){
    await sleep(ln.wait??1000); if(!alive(id)) return;
    call.lines.push(ln); renderCall();
    await sleep(Math.min(300+ln.text.length*70,2600)); if(!alive(id)) return;
  }
  if(hang!=null){ await sleep(hang); if(alive(id)) endCall(); }
}
function endCall(){
  if(!call) return;
  const c=call; clearInterval(timerId);
  const dur=c.state==='live'?Math.round((Date.now()-c.t0)/1000):0;
  S.recents.unshift({name:c.contact?c.contact.name:null,number:c.number,dir:c.incoming?(c.state==='live'?'in':'missed'):'out',ts:Date.now(),dur,count:1});
  call=null; ending=true; renderCall(c,true);
  setTimeout(()=>{ending=false;if(!call){$('#call').classList.remove('on');$('#screen').classList.remove('incall')} if(U.app==='phone'&&U.phone.tab==='recents') renderRecents()},850);
}
function renderCall(c=call,ended){
  if(!c) return;
  const ct=c.contact, name=callName(ct,c.number);
  const st=ended?'통화 종료':c.state==='dialing'?'휴대전화 연결 중…':c.state==='incoming'?'휴대전화 수신':mmss(Math.floor((Date.now()-c.t0)/1000));
  const shown=c.lines.slice(-3);
  const lines=shown.map((l,i)=>{const old=i<shown.length-1?' old':'';const who=l.who||'them';
    if(who==='sys') return `<div class="ln sys${old}"><p>${esc(l.text)}</p></div>`;
    return `<div class="ln ${who==='me'?'me':''}${old}"><small>${who==='me'?esc(CONFIG.meName):esc(name)}</small><p>${esc(l.text)}</p></div>`}).join('');
  const G=(p)=>`<svg viewBox="0 0 24 24"><path d="${p}"/></svg>`;
  let bottom;
  if(c.state==='incoming'&&!ended) bottom=`<div class="cinc"><label><button class="endbtn decl" data-act="decline" aria-label="거절">${G(PH)}</button>거절</label><label><button class="accbtn" data-act="accept" aria-label="받기">${G(PH)}</button>받기</label></div>`;
  else bottom=`<div class="cgrid">
    <button class="cb" data-act="tog"><i>${G('M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z')}</i>스피커</button>
    <button class="cb" data-act="tog"><i>${G('M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z')}</i>FaceTime</button>
    <button class="cb" data-act="tog"><i>${G('M19 11h-1.7c0 .74-.16 1.43-.43 2.05l1.23 1.23c.56-.98.9-2.09.9-3.28zm-4.02.17c0-.06.02-.11.02-.17V5c0-1.66-1.34-3-3-3S9 3.34 9 5v.18l5.98 5.99zM4.27 3L3 4.27l6.01 6.01V11c0 1.66 1.33 3 2.99 3 .22 0 .44-.03.65-.08l1.66 1.66c-.71.33-1.5.52-2.31.52-2.76 0-5.3-2.1-5.3-5.1H5c0 3.41 2.72 6.23 6 6.72V21h2v-3.28c.91-.13 1.77-.45 2.54-.9L19.73 21 21 19.73 4.27 3z')}</i>소리 끔</button>
    <button class="cb" data-act="tog"><i><svg viewBox="0 0 24 24"><circle cx="4.500" cy="12" r="2.200"/><circle cx="12" cy="12" r="2.200"/><circle cx="19.500" cy="12" r="2.200"/></svg></i>더 보기</button>
    <button class="cb end" data-act="end" aria-label="통화 종료"><i>${G(PH)}</i>종료</button>
    <button class="cb" data-act="tog"><i><svg viewBox="0 0 24 24"><circle cx="5" cy="3.500" r="2"/><circle cx="12" cy="3.500" r="2"/><circle cx="19" cy="3.500" r="2"/><circle cx="5" cy="9.500" r="2"/><circle cx="12" cy="9.500" r="2"/><circle cx="19" cy="9.500" r="2"/><circle cx="5" cy="15.500" r="2"/><circle cx="12" cy="15.500" r="2"/><circle cx="19" cy="15.500" r="2"/><circle cx="12" cy="21.500" r="2"/></svg></i>키패드</button>
    </div>`;
  const el=$('#call');
  el.className=(el.classList.contains('on')?'on':'')+(c.state==='incoming'?' ring':'')+((c.state==='dialing'||c.state==='incoming')&&!ended?' pre':'');
  el.innerHTML=`<div class="cl-top"><div class="cl-name">${esc(name)}</div><div class="cl-st" id="cl-st">${st}</div></div><div class="cl-tr">${lines}</div>${bottom}`;
}

/* ---------- 사진 ---------- */
function renderPhotos(){
  $('#ph-sub').textContent='12개의 항목';
  const ps=CONFIG.photos; let h='';
  for(let i=0;i<Math.max(12,ps.length);i++) h+=ps[i]?`<button class="pt" data-act="photo-open" data-i="${i}" aria-label="사진 ${i+1}"><img src="${esc(ps[i].src)}" alt=""></button>`:'<span class="pt"></span>';
  $('#ph-grid').innerHTML='<div class="pgrid">'+h+'</div>';
  if(U.photo!=null) openPhoto(U.photo); else $('#pviewer').hidden=true;
}
function openPhoto(i){
  const ps=CONFIG.photos, n=ps.length; if(!n){U.photo=null;return} i=(i+n)%n; const prevP=U.photo; U.photo=i; const p=ps[i];
  $('#pviewer').hidden=false; $('#pv-img').innerHTML=`<img src="${esc(p.src)}" alt="">`;
  const m=(p.date||'').match(/^(.*)\s(\d{1,2}:\d{2})$/); $('#pv-d').textContent=m?m[1]:(p.date||''); $('#pv-t').textContent=m?m[2]:'';
  const th=$('#pv-th'); th.innerHTML=ps.map((q,j)=>`<button data-act="photo-open" data-i="${j}" class="${j===i?'cur':''}" aria-label="사진 ${j+1}"><img src="${esc(q.src)}" alt=""></button>`).join('');
  const c=th.querySelector('.cur'); if(c) th.scrollLeft=c.offsetLeft-th.clientWidth/2+c.offsetWidth/2;
  if(p.fx==='glitch'&&prevP!==i) glitchFx();
}

/* ---------- 메모 ---------- */
function renderNotes(){
  $('#nt-rows').innerHTML=[...S.notes].sort((a,b)=>b.ts-a.ts).map(n=>`<button class="nr" data-act="note-open" data-id="${n.id}"><b>${n.locked&&!n.unlocked?'[잠김] ':''}${esc(n.title||'새로운 메모')}</b><span>${esc(rel(n.ts))} · ${n.locked&&!n.unlocked?'잠긴 메모':esc((n.text||'추가 텍스트 없음').split('\n')[0])}</span></button>`).join('')+'<div style="height:10px"></div>';
}
function openNote(id){U.note=id;$('#nt-list').hidden=true;$('#nt-view').hidden=false;renderNoteView()}
function renderNoteView(){
  const n=S.notes.find(x=>x.id===U.note); if(!n){U.note=null;return}
  $('#nt-list').hidden=true;$('#nt-view').hidden=false;
  if(n.locked&&!n.unlocked) $('#nt-body').innerHTML=`<div class="lkp"><svg width="34" height="34" viewBox="0 0 24 24" fill="#9b9ba1"><path d="M18 8h-1V6A5 5 0 0 0 7 6v2H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V10a2 2 0 0 0-2-2zM9 6a3 3 0 0 1 6 0v2H9V6z"/></svg><div>잠긴 메모예요.<br>4자리 번호를 입력하세요.</div><input id="nt-code" inputmode="numeric" maxlength="4" autocomplete="off" aria-label="비밀번호"><button data-act="note-unlock">열기</button><small id="nt-err"></small></div>`;
  else $('#nt-body').innerHTML=`<div class="nt-mod${n.mt&&Date.now()-n.mt<9e4?' on':''}" id="nt-mod">${n.mt&&Date.now()-n.mt<9e4?'방금 수정되었습니다':''}</div><input class="nt-title" id="nt-title" value="${esc(n.title)}" placeholder="제목"><textarea class="nt-text" id="nt-text" placeholder="메모를 입력하세요">${esc(n.text)}</textarea>`;
}

/* ---------- 캘린더 ---------- */
function evsOn(dt){const m=dt.getMonth()+1,d=dt.getDate(),w=dt.getDay(),k=dayKey(+dt);
  return [...(CONFIG.calendar||[]).filter(e=>(e.md&&e.md[0]===m&&e.md[1]===d)||(e.dow!=null&&e.dow===w)),...S.calEv.filter(e=>e.k===k)]}
function renderCal(){
  const {y,m,sel}=U.cal, n=new Date(y,m+1,0).getDate(), t=new Date(); let h='';
  for(let i=0;i<new Date(y,m,1).getDay();i++) h+='<i></i>';
  for(let d=1;d<=n;d++){const dt=new Date(y,m,d);
    h+=`<button data-act="cal-sel" data-d="${d}" class="${dayKey(+dt)===dayKey(+t)?'td ':''}${d===sel?'sl':''}"><span>${d}</span>${evsOn(dt).length?'<u></u>':''}</button>`}
  $('#cal-t').textContent=`${y}년 ${m+1}월`; $('#cal-g').innerHTML=h;
  const dt=new Date(y,m,sel), ev=evsOn(dt);
  $('#cal-ev').innerHTML=`<div class="ce-d">${m+1}월 ${sel}일 ${DOW[dt.getDay()]}요일</div>`+(ev.length?ev.map(e=>`<div class="ce"><i></i><span><b>${esc(e.title)}</b><small>${esc(e.time||'종일')}</small></span></div>`).join(''):'<div class="ce-n">일정 없음</div>');
}
$('#cal-form').addEventListener('submit',e=>{e.preventDefault();const v=$('#cal-in').value.trim();if(!v)return;const {y,m,sel}=U.cal;S.calEv.push({k:dayKey(+new Date(y,m,sel)),title:v});$('#cal-in').value='';renderCal()});

/* ---------- 이벤트 ---------- */
document.addEventListener('click',e=>{
  const el=e.target.closest('[data-act]'); if(!el) return; const d=el.dataset;
  switch(d.act){
    case 'pin-show': pinShow(); break;
    case 'pin-k': pinKey(d.k); break;
    case 'pin-del': pinDel(); break;
    case 'pin-cancel': $('#pin').classList.remove('on'); break;
    case 'open': showApp(d.app); break;
    case 'deco': toast('이 앱은 아직 지원하지 않아요'); break;
    case 'home': if(locked){pinShow();break} if(!call) goHome(); break;
    case 'sms-open': openSms(d.id); break;
    case 'sms-back': U.sms.id=null; $('#sms-thread').hidden=true; $('#sms-list').hidden=false; renderSmsList(); break;
    case 'kk-tab': U.kakao.tab=d.tab; renderKakaoMain(); break;
    case 'kk-open': openKakao(d.id); break;
    case 'kk-back': U.kakao.id=null; $('#kk-room').hidden=true; $('#kk-main').hidden=false; renderKakaoMain(); break;
    case 'sb-tab': U.sb.tab=d.tab; renderSbMain(); break;
    case 'sb-like': { const p=ent('sb',d.id); S.sb[d.id].state='liked'; toast('관심을 보냈어요'); renderSbMain(); if(p.matchBack!==false){const ep=epoch;setTimeout(()=>{if(ep===epoch)matchNow(p)},2200+Math.random()*1500)} break }
    case 'sb-open': openSb(d.id); break;
    case 'match-close': case 'match-later': closeMatch(); break;
    case 'match-chat': {const id=matchId; closeMatch(); if(id) openSb(id); break}
    case 'sb-back': U.sb.id=null; $('#sb-room').hidden=true; $('#sb-main').hidden=false; renderSbMain(); break;
    case 'ph-tab': setPhoneTab(d.tab); break;
    case 'key': if(U.phone.dial.length<13){U.phone.dial+=d.k; renderDial()} break;
    case 'del': U.phone.dial=U.phone.dial.slice(0,-1); renderDial(); break;
    case 'dial': { const n=digits(U.phone.dial); if(!n) break; startCall(n,CONFIG.contacts.find(c=>c.number&&digits(c.number)===n)||null); break }
    case 'call-contact': { const c=byId(d.id); startCall(digits(c.number),c); break }
    case 'call-recent': { const r=S.recents[+d.i]; const c=CONFIG.contacts.find(c=>c.number&&digits(c.number)===digits(r.number)); startCall(digits(r.number),c||null); break }
    case 'end': case 'decline': endCall(); break;
    case 'accept': if(call) connect(call.id); break;
    case 'tog': el.classList.toggle('on'); break;
    case 'photo-open': openPhoto(+d.i); break;
    case 'photo-close': U.photo=null; $('#pviewer').hidden=true; break;
    case 'pv-like': el.classList.toggle('liked'); break;
    case 'photo-prev': openPhoto(U.photo-1); break;
    case 'photo-next': openPhoto(U.photo+1); break;
    case 'note-open': openNote(d.id); break;
    case 'note-back': U.note=null; $('#nt-view').hidden=true; $('#nt-list').hidden=false; renderNotes(); break;
    case 'note-new': { const n={id:'n'+Date.now(),title:'',text:'',ts:Date.now(),ago:0}; S.notes.unshift(n); openNote(n.id); break }
    case 'note-unlock': { const n=S.notes.find(x=>x.id===U.note); const v=($('#nt-code').value||'').trim(); if(v===n.code){n.unlocked=true;renderNoteView();fireTrigger('unlock:'+n.id)} else {$('#nt-err').textContent='번호가 맞지 않아요.'} break }
    case 'cal-prev': case 'cal-next': { const c=U.cal, t=new Date(c.y,c.m+(d.act==='cal-next'?1:-1),1); c.y=t.getFullYear(); c.m=t.getMonth(); c.sel=1; renderCal(); break }
    case 'cal-sel': U.cal.sel=+d.d; renderCal(); break;
    case 'banner': if(bannerTarget){ $('#banner').classList.remove('on'); if(call) break; showApp(bannerTarget.app); const {app,id}=bannerTarget; if(app==='sms') openSms(id); else if(app==='kakao') openKakao(id); else openSb(id) } break;
  }
});
document.addEventListener('input',e=>{
  const n=U.note&&S.notes.find(x=>x.id===U.note);
  if(e.target.id==='nt-title'&&n){n.title=e.target.value;n.ts=Date.now()}
  if(e.target.id==='nt-text'&&n){n.text=e.target.value;n.ts=Date.now()}
});
const bindForm=(form,input,go,app)=>{
  input.addEventListener('input',()=>{const on=!!input.value.trim(); if(app==='kakao') go.classList.toggle('on',on); else go.disabled=!on});
  form.addEventListener('submit',e=>{e.preventDefault(); const id=U[app].id; if(!id) return; sendMsg(app,id,input.value); input.value=''; if(app==='kakao') go.classList.remove('on'); else go.disabled=true; input.focus()});
};
{let x0=null;const el=$('#pv-img');el.addEventListener('pointerdown',e=>{x0=e.clientX});el.addEventListener('pointerup',e=>{if(x0==null)return;const dx=e.clientX-x0;x0=null;if(Math.abs(dx)>40)openPhoto(U.photo+(dx<0?1:-1))})}
bindForm($('#sms-form'),$('#sms-input'),$('#sms-go'),'sms');
bindForm($('#kk-form'),$('#kk-input'),$('#kk-go'),'kakao');
bindForm($('#sb-form'),$('#sb-input'),$('#sb-go'),'sb');
document.addEventListener('keydown',e=>{
  if(U.app!=='phone'||U.phone.tab!=='keypad'||call||locked||e.target.tagName==='INPUT'||e.target.tagName==='TEXTAREA') return;
  if(/^[0-9*#]$/.test(e.key)&&U.phone.dial.length<13){U.phone.dial+=e.key;renderDial()}
  else if(e.key==='Backspace'){U.phone.dial=U.phone.dial.slice(0,-1);renderDial()}
  else if(e.key==='Enter'){const n=digits(U.phone.dial);if(n)startCall(n,CONFIG.contacts.find(c=>c.number&&digits(c.number)===n)||null)}
});

function fit(){
  const bare=false; document.body.classList.toggle('bare',bare);
  const W=bare?390:420,H=bare?844:874;
  const aw=document.documentElement.clientWidth-32, ah=innerHeight-40;
  const s=Math.max(.45,Math.min(1,aw/W,ah/H));
  const f=$('#fit'); f.style.width=W*s+'px'; f.style.height=H*s+'px'; $('#phone').style.transform=`scale(${s})`;
}
function reset(){
  epoch++; chains={}; fired.clear(); dwell=0; sbT0=0; adDone=false; adTries=0; $('#ad').classList.remove('on'); $('#obit').classList.remove('on'); adSchedule(CONFIG.airdrop.at); clearInterval(timerId); call=null; ending=false; callSeq++; eventsRan=false;
  $('#call').classList.remove('on'); $('#banner').classList.remove('on');
  initState(); U.app=null; U.sms.id=null; U.kakao.id=null; U.kakao.tab='friends'; U.sb.id=null; U.sb.tab='discover'; U.phone.tab='keypad'; U.phone.dial=''; U.photo=null; U.note=null; {const t=new Date();U.cal={y:t.getFullYear(),m:t.getMonth(),sel:t.getDate()}}
  ['#sms-input','#kk-input','#sb-input'].forEach(s=>$(s).value='');
  renderHome(); renderKeypad(); renderSmsList(); renderKakaoMain(); renderSbMain(); updateBadges(); goHome();
  locked=true; $('#matchm').classList.remove('on'); $('#pin').classList.remove('on','out'); $('#lock').classList.remove('out'); $('#lock').classList.add('on'); renderLock(); updateClock();
}
addEventListener('resize',fit);
fit(); reset(); setInterval(updateClock,20000); setInterval(tick,1000);
})();
