      LKSEEN.add(k); LKSCH.delete(k); lkSig=lkSigOf();
      const el=[...document.querySelectorAll('#lk-n .lkc')].find(e=>e.dataset.k===k);
      if(el){el.classList.remove('pend'); el.classList.add('drop')}
    },(lkFirst?cfg.first:200)+idx*cfg.gap);
