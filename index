/* ---------- 전화 ---------- */
const KEYS=[['1',''],['2','ABC'],['3','DEF'],['4','GHI'],['5','JKL'],['6','MNO'],['7','PQRS'],['8','TUV'],['9','WXYZ'],['*',''],['0','+'],['#','']];
function renderKeypad(){$('#kp').innerHTML=KEYS.map(([k,s])=>`<button class="key" data-act="key" data-k="${k}"><b>${k}</b><small>${s}</small></button>`).join('')}
