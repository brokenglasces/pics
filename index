const LKSEEN=new Set(), LKSCH=new Set(); let lkSig='', lkFirst=true, lkKeys=[];
function lkSigOf(){return lkKeys.map(k=>k+(LKSEEN.has(k)?'1':'0')).join('|')}
function renderLock(){
  const d=new Date();
  $('#lk-time').textContent=`${d.getHours()%12||12}:${String(d.getMinutes()).padStart(2,'0')}`;
  $('#lk-date').textContent=`${d.getMonth()+1}월 ${d.getDate()}일 ${DOW[d.getDay()]}요일`;
  const all=[];
  ['sms','kakao','sb'].forEach(app=>Object.entries(S[app]).forEach(([id,t])=>{
    if(!t.unread) return; const m=[...t.msgs].reverse().find(m=>m.from==='them'); if(m) all.push({app,id,ts:m.ts,text:m.text});
  }));
  all.sort((a,b)=>b.ts-a.ts);
  const top=all.slice(0,3), cfg=CONFIG.lockNotify||{first:1500,gap:2400};
  lkKeys=top.map(n=>`${n.app}:${n.id}:${n.ts}`);
  let idx=0;
  [...lkKeys].reverse().forEach(k=>{  /* 맨 아래 카드부터 차례로 */
    if(LKSEEN.has(k)||LKSCH.has(k)) return;
    LKSCH.add(k);
