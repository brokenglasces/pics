class WAPlayer{
  constructor(url){this.url=url;this.ev={};this.ctx=null;this.buf=null;this.src=null;this.gain=null;this._vol=.7;this._off=0;this._start=0;this._playing=false;this.ended=false;this.duration=NaN}
