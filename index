function fmtTime(d){let h=d.getHours();const m=d.getMinutes();const ap=h<12?'오전':'오후';h=h%12||12;return `${ap} ${h}:${String(m).padStart(2,'0')}`}
function dayDiff(ts){const d=new Date(ts),n=new Date();return Math.round((new Date(n.getFullYear(),n.getMonth(),n.getDate())-new Date(d.getFullYear(),d.getMonth(),d.getDate()))/864e5)}
function dayKey(ts){const d=new Date(ts);return d.getFullYear()+'-'+d.getMonth()+'-'+d.getDate()}
function rel(ts){const n=dayDiff(ts),d=new Date(ts);if(n<=0)return fmtTime(d);if(n===1)return '어제';return `${d.getMonth()+1}월 ${d.getDate()}일`}
function dayWord(ts){const n=dayDiff(ts),d=new Date(ts);if(n<=0)return '오늘';if(n===1)return '어제';return `${d.getMonth()+1}월 ${d.getDate()}일`}
function fullDay(ts){const d=new Date(ts);return `${d.getFullYear()}년 ${d.getMonth()+1}월 ${d.getDate()}일 ${DOW[d.getDay()]}요일`}
function fmtNum(s){const d=digits(s);if(d.length<=3)return d;if(d.length<=7)return d.slice(0,3)+'-'+d.slice(3);return d.slice(0,3)+'-'+d.slice(3,7)+'-'+d.slice(7,11)}
