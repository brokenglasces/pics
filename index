#kk-room{background:#b0c2d3;position:relative}
#kk-room .kmsgs{position:absolute;inset:0;padding:114px 10px 96px;background:#b0c2d3;scrollbar-width:none}
.kgl{background:rgba(238,245,251,.74);-webkit-backdrop-filter:blur(18px) saturate(1.4);backdrop-filter:blur(18px) saturate(1.4);box-shadow:0 2px 14px rgba(40,70,100,.15),inset 0 0 0 1px rgba(255,255,255,.7);border:0;color:#1d2a36;font-family:var(--ph)}
.kk-rh{position:absolute;top:0;left:0;right:0;height:120px;z-index:5;pointer-events:none}
.kk-rh::before{content:"";position:absolute;inset:0;background:linear-gradient(rgba(176,194,211,.97),rgba(176,194,211,.85) 62%,rgba(176,194,211,0));-webkit-backdrop-filter:blur(9px);backdrop-filter:blur(9px);-webkit-mask-image:linear-gradient(#000 66%,transparent);mask-image:linear-gradient(#000 66%,transparent)}
.kk-back{position:absolute;left:16px;top:50px;height:44px;min-width:44px;border-radius:22px;padding:0 16px 0 15px;display:flex;align-items:center;gap:9px;font-size:19px;font-weight:800;pointer-events:auto;cursor:pointer;box-sizing:border-box}
.kk-back svg{width:11px;height:19px}
